<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>31.0</SupportedOSPlatformVersion>
    <AndroidMinSdkVersion>31</AndroidMinSdkVersion>
    <AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <ApplicationId>io.github.doctorllll.pkhex.android</ApplicationId>
    <ApplicationTitle>PKHeX</ApplicationTitle>
    <RootNamespace>PKHeX.Android</RootNamespace>
    <AssemblyTitle>PKHeX Android</AssemblyTitle>
    <Product>PKHeX</Product>
    <Version>$(UIVersion)</Version>

    <!-- android:versionCode. Android decides what counts as an upgrade from this integer, not from
         the version name, and it defaulted to 1 on every release: an updater or store would have
         seen every build as the same version. Derived from UIVersion so it rises with each release
         on its own. The scheme (major*100000 + minor*1000 + patch) holds minor and patch below
         1000 and stays far under Android's 2100000000 ceiling. -->
    <_UIVersionMajor>$([System.Version]::Parse('$(UIVersion)').Major)</_UIVersionMajor>
    <_UIVersionMinor>$([System.Version]::Parse('$(UIVersion)').Minor)</_UIVersionMinor>
    <_UIVersionPatch>$([System.Version]::Parse('$(UIVersion)').Build)</_UIVersionPatch>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(_UIVersionMajor), 100000)), $([MSBuild]::Multiply($(_UIVersionMinor), 1000)))), $(_UIVersionPatch)))</ApplicationVersion>
    <ApplicationDisplayVersion>$(UIVersion)</ApplicationDisplayVersion>
    <AssemblyVersion>$(UIVersion).0</AssemblyVersion>
    <FileVersion>$(UIVersion).0</FileVersion>
    <InformationalVersion>$(UIVersion)</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The local .NET Android workload's fast-deploy target can stall on this Avalonia host;
         apply the API-36 smoke-test deployment policy after the SDK targets are loaded. -->
    <AfterMicrosoftNETSdkTargets>$(AfterMicrosoftNETSdkTargets);$(MSBuildThisFileDirectory)AndroidHost.targets</AfterMicrosoftNETSdkTargets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Android" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <!-- Keep the Android native renderer on the repository's SkiaSharp 3.x line. Avalonia.Skia
         11.3.18 otherwise resolves its legacy 2.88.9 Android native asset, which triggers the
         Android 16 16-KB-page-size warning during APK packaging. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PKHeX.Core\PKHeX.Core.csproj" />
    <ProjectReference Include="..\PKHeX.Application\PKHeX.Application.csproj" />
    <ProjectReference Include="..\PKHeX.Infrastructure\PKHeX.Infrastructure.csproj" />
    <ProjectReference Include="..\PKHeX.Presentation\PKHeX.Presentation.csproj" />
    <ProjectReference Include="..\PKHeX.Avalonia\PKHeX.Avalonia.csproj" AdditionalProperties="OutputType=Library" />
  </ItemGroup>
</Project>
