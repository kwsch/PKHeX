<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Touch sizing for the Android host. The shared views are laid out for a mouse, whose hit
      targets can be a few pixels wide; a finger needs ~48dp. These styles only load in the Android
      app, so the desktop keeps its denser layout.
    -->

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="48" />
    </Style>

    <!-- Box/party slots size themselves from the grid; forcing a min height would break the grid. -->
    <Style Selector="Button.slot">
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="ToggleButton">
        <Setter Property="MinHeight" Value="48" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="48" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="48" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="48" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="48" />
    </Style>

    <!-- Menu rows are the primary navigation until the shell moves to a bottom bar. -->
    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="48" />
    </Style>

    <!-- Desktop tab labels are sized for a wide window; at that size the entity editor's eight
         section tabs need three rows on a phone. -->
    <Style Selector="TabItem">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- Bottom navigation: five destinations only fit on one row at a label size the desktop
         tab strip never has to consider. -->
    <Style Selector="TabControl[TabStripPlacement=Bottom] > TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- A finger cannot reliably hit a 4px scrollbar; keep them visible and wide enough to drag. -->
    <Style Selector="ScrollBar">
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="MinHeight" Value="12" />
    </Style>
</Styles>
