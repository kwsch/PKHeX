@implements IAsyncDisposable
@inject IJSRuntime JS
@inject WorkspaceState State

@* The shell: heading, About, and the workspace inside a fault boundary. It stays mounted when the workspace faults,
   so the unsaved-changes warning keeps following WorkspaceState while the recovery screen is shown. *@
<PageTitle>PKHeX Web</PageTitle>
<div class="page">
    <header>
        <h1>PKHeX Web</h1>
        <button id="about-toggle" type="button" aria-expanded="@(aboutOpen ? "true" : "false")" aria-controls="about" @onclick="() => aboutOpen = !aboutOpen">About</button>
    </header>
    <AboutPanel Id="about" Hidden="!aboutOpen" />
    <main>
        <FaultBoundary>
            <Workspace />
        </FaultBoundary>
    </main>
</div>

@code {
    private IJSObjectReference? lifecycle;
    private bool aboutOpen;

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            lifecycle = await JS.InvokeAsync<IJSObjectReference>("import", "./lifecycle.js");
            await SyncDirtyAsync();
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(SyncDirtyAsync);

    /// <summary>Arms the <c>beforeunload</c> warning exactly while leaving would lose work.</summary>
    private async Task SyncDirtyAsync()
    {
        if (lifecycle is null)
        {
            return;
        }
        try
        {
            await lifecycle.InvokeVoidAsync("setDirty", State.HasUnsavedWork);
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; there is nothing left to warn about.
        }
        catch (JSException)
        {
            // The warning is a convenience; failing to update it must not break the page. The next change retries.
        }
    }

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        if (lifecycle is null)
        {
            return;
        }
        try
        {
            await lifecycle.InvokeVoidAsync("setDirty", false);
            await lifecycle.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is already gone, and its listeners with it.
        }
    }
}
