@* The preview of a party member's HP reduction, shown before the draft is applied. It follows typed level, IV and EV edits, so it is not a
   live region, which would interrupt every keystroke; Apply is described by it (aria-describedby="party-hp-preview") instead. *@
<div id="party-hp-region">
    @if (PartyText.HpPreview(Change) is { } text)
    {
        <p id="party-hp-preview">@text</p>
    }
</div>

@code {
    /// <summary>The draft's HP change (see <see cref="EditorDraft.HpChange"/>), or null for a box slot or when HP is unchanged.</summary>
    [Parameter] public PartyHpChange? Change { get; set; }
}
