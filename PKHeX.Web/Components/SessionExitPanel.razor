@* The steps of leaving a changed session (replace, close or reset): first the draft, then the session's changes, then confirming a download.
   A discard has a single step instead, which names what it loses.
   It shows only the current step's choices. The step is worked out by WorkspaceState from the live session and passed in, so it cannot go stale,
   and a change of step is a change of parameter, which re-renders the panel.
   The work itself (apply, download) is done by the workspace through the callbacks, which also report the outcome.
   It is a native modal dialog: the browser keeps focus and pointer input inside it, and makes the page behind it inert, until
   the exit ends or is cancelled. Escape cancels, as "Cancel and keep this save" does. *@
@inject BrowserPage Page
@inject DiagnosticLog Diagnostics
@if (Exit is { } exit)
{
    var stage = Stage;
    @* The cancel event's default (closing the dialog) is prevented by browser.js showModal, so the dialog closes only by being removed when
       the exit ends; Razor has no preventDefault modifier for this event. *@
    @* open is rendered only when the modal could not be shown: a dialog that is not open is not displayed at all. *@
    <dialog id="exit" aria-labelledby="exit-title" open="@modalFailed" @ref="dialog" @oncancel="Cancelled" @onclose="Closed">
        @* Focus moves to the heading at each step, which announces it; a live region as well would announce it twice. *@
        <h2 id="exit-title" tabindex="-1" @ref="heading">@SessionStatusText.ExitTitle(exit)</h2>
        @* Only a replace waits on another file; a reset's candidate is the open file parsed again. *@
        @if (exit is { Intent: ExitIntent.Replace, Candidate: { } candidate })
        {
            <p>Waiting to open: <code id="exit-name">@candidate.FileName</code></p>
        }
        @* The page's status message is behind the dialog, and inert while it is open, so the step outcomes it reports are repeated here. *@
        <p id="exit-status" role="status">@Message</p>
        <p id="exit-prompt">@(stage == ExitStage.ConfirmDiscard ? SessionStatusText.DiscardPrompt(DraftPending, ExportStatus) : SessionStatusText.ExitPrompt(stage))</p>
        @switch (stage)
        {
            case ExitStage.ResolveDraft:
                @if (CanApplyDraft)
                {
                    <ApplyAcknowledgement Id="exit-apply-ack" Gate="ApplyGate" Verdict="ApplyVerdict" Disabled="Busy" OnAcknowledge="OnAcknowledgeApply" />
                    <button id="exit-apply-draft" type="button" @onclick="OnApplyDraft" disabled="@(Busy || !LegalityAllowsApply)">Apply draft</button>
                }
                <button id="exit-discard-draft" type="button" @onclick="OnDiscardDraft" disabled="@Busy">Discard draft</button>
                break;
            case ExitStage.ResolveSession:
                <ExportAcknowledgement Id="exit-export-ack" Flagged="Flagged" Acknowledged="ExportAcknowledged" Disabled="Busy" OnAcknowledge="OnAcknowledgeExport" />
                <button id="exit-export" type="button" @onclick="OnExport" disabled="@(Busy || !ExportAllowed)">Download save</button>
                <button id="exit-discard-session" type="button" @onclick="OnDiscardSession" disabled="@Busy">@SessionStatusText.DiscardSession(exit)</button>
                break;
            case ExitStage.ConfirmExport:
                @* Shown here too: the acknowledgement can be withdrawn after the download, and Download again needs it. *@
                <ExportAcknowledgement Id="exit-export-ack" Flagged="Flagged" Acknowledged="ExportAcknowledged" Disabled="Busy" OnAcknowledge="OnAcknowledgeExport" />
                <button id="exit-continue" type="button" @onclick="OnContinue" disabled="@Busy">@SessionStatusText.Continue(exit, stage)</button>
                <button id="exit-export" type="button" @onclick="OnExport" disabled="@(Busy || !ExportAllowed)">Download again</button>
                break;
            case ExitStage.ConfirmDiscard:
                <button id="exit-discard-session" type="button" @onclick="OnDiscardSession" disabled="@Busy">@SessionStatusText.DiscardSession(exit)</button>
                break;
            case ExitStage.Ready:
                <button id="exit-continue" type="button" @onclick="OnContinue" disabled="@Busy">@SessionStatusText.Continue(exit, stage)</button>
                break;
        }
        <button id="exit-cancel" type="button" @onclick="OnCancel" disabled="@Busy">Cancel and keep this save</button>
    </dialog>
}

@code {
    private ElementReference heading, dialog;

    /// <summary>
    /// True when the dialog could not be shown as a modal; it is then rendered open, in place, without the modal behaviour, so the exit can
    /// still be resolved or cancelled.
    /// </summary>
    private bool modalFailed;
    private (SessionExit? Exit, ExitStage Stage) focusedStep;

    /// <summary>The exit in progress (<see cref="WorkspaceState.Exit"/>); nothing is rendered when null.</summary>
    [Parameter] public SessionExit? Exit { get; set; }

    /// <summary>What the exit waits for (<see cref="WorkspaceState.ExitStage"/>).</summary>
    [Parameter] public ExitStage Stage { get; set; }

    /// <summary>
    /// True when the draft can be applied apart from legality: its position is written by this release, its last edit was accepted and no species
    /// preview is pending. Otherwise it can only be discarded.
    /// </summary>
    [Parameter] public bool CanApplyDraft { get; set; }

    /// <summary>What legality asks before the draft can be applied (<see cref="DraftLegality.Gate"/>).</summary>
    [Parameter] public LegalityGate ApplyGate { get; set; }

    /// <summary>The verdict to acknowledge when <see cref="ApplyGate"/> asks for one.</summary>
    [Parameter] public LegalityVerdict ApplyVerdict { get; set; }

    /// <summary>The session's flagged changes, listed at the download step (<see cref="SaveSession.FlaggedChanges"/>).</summary>
    [Parameter] public IReadOnlyDictionary<SlotRef, LegalityVerdict> Flagged { get; set; } = new Dictionary<SlotRef, LegalityVerdict>();

    /// <summary>True when the flagged changes are acknowledged for the current revision.</summary>
    [Parameter] public bool ExportAcknowledged { get; set; }

    /// <summary>For a discard's prompt: true when the draft has unapplied or refused changes.</summary>
    [Parameter] public bool DraftPending { get; set; }

    /// <summary>For a discard's prompt: the session's download status.</summary>
    [Parameter] public ExportStatus ExportStatus { get; set; }

    /// <summary>Acknowledge (or withdraw) the draft's legality result.</summary>
    [Parameter] public EventCallback<bool> OnAcknowledgeApply { get; set; }

    /// <summary>Acknowledge (or withdraw) the flagged changes for this download.</summary>
    [Parameter] public EventCallback<bool> OnAcknowledgeExport { get; set; }

    private bool LegalityAllowsApply => ApplyGate is LegalityGate.Clear or LegalityGate.Acknowledged;

    private bool ExportAllowed => Flagged.Count == 0 || ExportAcknowledged;

    /// <summary>True while another operation runs; every choice is disabled.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Apply the draft and move on.</summary>
    [Parameter] public EventCallback OnApplyDraft { get; set; }

    /// <summary>Discard the draft and move on.</summary>
    [Parameter] public EventCallback OnDiscardDraft { get; set; }

    /// <summary>Download the current revision.</summary>
    [Parameter] public EventCallback OnExport { get; set; }

    /// <summary>Complete the exit after the download was checked, or when nothing would be lost.</summary>
    [Parameter] public EventCallback OnContinue { get; set; }

    /// <summary>Complete the exit without a download.</summary>
    [Parameter] public EventCallback OnDiscardSession { get; set; }

    /// <summary>Abandon the exit.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>The page's latest status message, repeated inside the dialog, where it is announced.</summary>
    [Parameter] public string Message { get; set; } = "";

    /// <summary>
    /// Opens the dialog as a modal when an exit first shows it, then moves focus to the heading at each new step, which announces it.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var step = (Exit, Stage);
        if (step.Exit is null || step == focusedStep)
        {
            focusedStep = step;
            // The next exit tries the modal again.
            modalFailed &= step.Exit is not null;
            return;
        }
        var opening = focusedStep.Exit is null;
        focusedStep = step;
        if (opening)
        {
            await ShowModalAsync();
        }
        await heading.FocusAsync();
    }

    /// <summary>Shows the dialog as a modal; a failure is recorded, and the dialog is then shown in place without the modal behaviour.</summary>
    private async Task ShowModalAsync()
    {
        try
        {
            await Page.ShowModalAsync(dialog);
        }
        catch (JSException ex)
        {
            Diagnostics.Record(DiagnosticOperation.Focus, ex);
            modalFailed = true;
            StateHasChanged();
        }
    }

    /// <summary>Escape: cancels the exit, as the cancel button does, unless another operation is running.</summary>
    private Task Cancelled() => Busy ? Task.CompletedTask : OnCancel.InvokeAsync();

    /// <summary>
    /// The browser closed the dialog itself: a close request it does not let the page refuse (repeated Escape without other input, under the
    /// close-watcher rules). The exit is cancelled as Escape would cancel it; while another operation runs, the dialog is shown again instead.
    /// </summary>
    private Task Closed()
    {
        if (Exit is null)
        {
            return Task.CompletedTask;
        }
        return Busy ? ShowModalAsync() : OnCancel.InvokeAsync();
    }
}
