@using System.Globalization
@* The draft's editable fields: species and form, name and language, friendship towards each trainer, level and experience points, nature, ability and gender,
   IVs and EVs, the held item, and the moves with their PP and PP Ups. Every change
   goes through OnEdit, which runs it on the draft and reports a refusal; this component only turns input into typed draft edits and shows
   what the draft holds. *@
<h3 id="draft-edit-title">Edit</h3>
@if (Draft.IsEgg)
{
    <p id="egg-note">@EditorText.EggReadOnly</p>
}
<fieldset id="species-fields">
    <legend>Species and form</legend>
    @* A species or form choice is previewed before it is made (WEB-PKM-002): while a preview is shown, the boxes hold the previewed choice,
       and the draft changes only when it is confirmed. The species box lists Core's species for the save; the form box the species' forms
       from Core's list for the generation, marked when battle-only or not in this game (see EditorDraft.FormChoices). *@
    <label for="species">Species</label>
    @* Keyed on the refusal count: a refused choice leaves the value Blazor last rendered unchanged, so it would not reset the box the user
       changed; a new key renders it again with the draft's value. *@
    <ChoiceSelect @key="SpeciesKey" @ref="speciesSelect" Id="species" Items="Draft.Capabilities.SpeciesChoices" Value="ShownSpecies" Disabled="!Can(EditableFields.Species)"
                  DescribedBy="species-note" Unlisted="UnlistedSpecies" OnChange="SpeciesChosen" />
    <label for="form">Form</label>
    <select @key="FormKey" id="form" value="@ShownForm.ToString(CultureInfo.InvariantCulture)" @onchange="FormChosen" aria-describedby="species-note"
            disabled="@(!Can(EditableFields.Species) || ShownForms.Count == 0)">
        @if (ShownForms.Count == 0)
        {
            <option value="@ShownForm">@(ShownForm == 0 ? EditorText.NoAlternateForms : EditorText.UnlistedForm(ShownForm))</option>
        }
        else
        {
            @if (ShownForm >= ShownForms.Count)
            {
                <option value="@ShownForm" disabled>@EditorText.UnlistedForm(ShownForm)</option>
            }
            @foreach (var choice in ShownForms)
            {
                <option value="@choice.Form">@EditorText.FormName(choice)</option>
            }
        }
    </select>
    <p id="species-note">@EditorText.SpeciesNote</p>
    @* Always rendered, so a screen reader announces a preview or a refusal when it appears. *@
    <div id="species-preview" role="status">
        @if (preview is not null)
        {
            <p id="species-preview-title">@EditorText.PreviewTitle(preview, SpeciesName, FormNameOf(preview))</p>
            <ul id="species-preview-changes">
                @foreach (var line in EditorText.SpeciesFormChanges(preview, SpeciesName, FormNameOf(preview), AbilityName))
                {
                    <li>@line</li>
                }
            </ul>
        }
        else if (previewRefusal is { } refusal)
        {
            <p id="species-preview-refusal">@UserMessages.For(refusal)</p>
        }
    </div>
    @if (preview is not null)
    {
        <button type="button" id="species-confirm" @onclick="ConfirmSpeciesForm">@EditorText.ConfirmSpeciesForm</button>
        <button type="button" id="species-cancel" @onclick="CancelSpeciesForm">@EditorText.CancelSpeciesForm</button>
    }
    @* Always rendered, so a screen reader announces a change of its text. *@
    <p id="species-change" role="status">@(speciesChange is null ? "" : EditorText.SpeciesFormChanged(speciesChange))</p>
</fieldset>
<fieldset id="name-fields">
    <legend>Name</legend>
    <label for="nickname">Nickname</label>
    @* Fields the draft cannot change (all of them when the position cannot be applied, or for an egg) are read-only, so nothing is drafted that could never be applied. *@
    <input id="nickname" value="@nickname" @oninput="NicknameTyped" maxlength="@Draft.MaxNicknameLength" readonly="@(!Can(EditableFields.Nickname))" />
    <label><input id="nicknamed" type="checkbox" checked="@nicknamed" @onchange="FlagChanged" disabled="@(!Can(EditableFields.Nickname))" /> Is nicknamed</label>
    <label for="language">Language</label>
    @* Each select's value is set on the select, not as an option's selected attribute, which Firefox ignores once the user has chosen an option
       (see ChoiceSelect). *@
    <select id="language" value="@language.ToString(CultureInfo.InvariantCulture)" @onchange="LanguageChanged" disabled="@(!Can(EditableFields.Language))">
        @if (!Listed(language))
        {
            <option value="@language" disabled>@EditorText.UnlistedLanguage(language)</option>
        }
        @foreach (var item in Draft.Capabilities.Lists.Languages)
        {
            <option value="@item.Value">@item.Text</option>
        }
    </select>
    @* Always rendered, so a screen reader announces a change of its text. *@
    <p id="name-note" role="status">@EditorText.NameNote(Draft.Name, Draft.IsNicknamed, LanguageName, renamed)</p>
</fieldset>
<fieldset id="friendship-fields">
    <legend>Friendship</legend>
    @* Friendship fields are text with a numeric keyboard, not type=number: a number field reports partly typed text such as "1e" or "-" as
       empty, so it could be neither shown as typed nor told apart from a cleared field. The draft refuses anything but 0–255. *@
    <label for="ot-friendship">@EditorText.TrainerFriendshipLabel(Draft.TrainerName)</label>
    <input id="ot-friendship" type="text" inputmode="numeric" autocomplete="off" value="@trainerFriendship"
           @oninput="TrainerFriendshipTyped" readonly="@(!Can(EditableFields.Friendship))" />
    <label for="ht-friendship">@EditorText.HandlerFriendshipLabel(Draft.HandlerName)</label>
    <input id="ht-friendship" type="text" inputmode="numeric" autocomplete="off" value="@handlerFriendship"
           @oninput="HandlerFriendshipTyped" readonly="@(!Can(EditableFields.Friendship) || !Draft.HasHandlingTrainer)"
           aria-describedby="@(Draft.HasHandlingTrainer ? null : "ht-note")" />
    @if (!Draft.HasHandlingTrainer)
    {
        <p id="ht-note">@EditorText.NoHandler</p>
    }
    <p id="friendship-note">@EditorText.CurrentFriendship(Draft.IsWithHandler)</p>
</fieldset>
<fieldset id="level-fields">
    <legend>Level and experience</legend>
    @* Text with a numeric keyboard, as for friendship. The draft refuses a level outside 1–100 and experience points outside the growth
       curve; neither is clamped. *@
    <label for="level">@EditorText.LevelLabel</label>
    <input id="level" type="text" inputmode="numeric" autocomplete="off" value="@level" @oninput="LevelTyped" readonly="@(!Can(EditableFields.Level))" />
    <label for="exp">@EditorText.ExperienceLabel(Draft.Progress.Maximum)</label>
    <input id="exp" type="text" inputmode="numeric" autocomplete="off" value="@experience" @oninput="ExperienceTyped" readonly="@(!Can(EditableFields.Level))" />
    @* Always rendered, so a screen reader announces a change of its text. *@
    <p id="level-note" role="status">@EditorText.LevelNote(Draft.Progress)</p>
</fieldset>
<fieldset id="nature-fields">
    <legend>Nature</legend>
    <label for="nature">Nature</label>
    <select id="nature" value="@nature.ToString(CultureInfo.InvariantCulture)" @onchange="NatureChanged" disabled="@(!Can(EditableFields.Nature))">
        @if (!ListedNature(nature))
        {
            <option value="@nature" disabled>@EditorText.UnlistedNature(nature)</option>
        }
        @foreach (var item in Draft.Capabilities.Lists.Natures)
        {
            <option value="@item.Value">@item.Text</option>
        }
    </select>
    <p id="nature-note" role="status">@EditorText.NatureNote(NatureEffect.Of(Draft.Nature))</p>
</fieldset>
<fieldset id="ability-fields">
    <legend>Ability and gender</legend>
    @* The ability box lists the slots of the species and form from Core's personal data; its values are slots, so two slots with the same
       ability stay apart, and choosing one sets the ability and its slot number together (see EditorDraft.EditAbilitySlot). *@
    <label for="ability">Ability</label>
    <ChoiceSelect Id="ability" Items="Draft.AbilityChoices" Value="abilitySlot" Disabled="!Can(EditableFields.Ability)" DescribedBy="ability-note"
                  Unlisted="UnmatchedAbility" OnChange="AbilityChanged" />
    <p id="ability-note" role="status">@EditorText.AbilityNote(Draft.RegularAbilitiesSame, Draft.AbilitySlot is null)</p>
    @* Only the genders the species can have are offered; a stored value it cannot have is shown as stored, and is replaced by choosing one. *@
    <label for="gender">Gender</label>
    <select id="gender" value="@gender.ToString(CultureInfo.InvariantCulture)" @onchange="GenderChanged" aria-describedby="gender-note"
            disabled="@(!Can(EditableFields.Gender) || (Draft.GenderChoices.Count == 1 && Draft.GenderChoices[0] == gender))">
        @if (!Draft.GenderChoices.Any(g => g == gender))
        {
            <option value="@gender" disabled>@EditorText.GenderName((byte)gender)</option>
        }
        @foreach (var choice in Draft.GenderChoices)
        {
            <option value="@choice">@EditorText.GenderName(choice)</option>
        }
    </select>
    <p id="gender-note">@EditorText.GenderNote(Draft.GenderRule, Draft.FormFollowsGender)</p>
    @* Always rendered, so a screen reader announces a change of its text. *@
    <p id="gender-change" role="status">@EditorText.GenderChangeNote(genderChange, AbilityName, Draft.Level)</p>
</fieldset>
<fieldset id="stat-fields">
    <legend>IVs and EVs</legend>
    @* Text with a numeric keyboard, as for friendship. The draft refuses an IV or EV out of range, and an EV that raises the total above the
       limit; nothing is clamped. Each field is named by its row and column headers ("Attack (raised by nature) IV (0–31)"). *@
    <table class="stat-edit">
        <thead>
            <tr>
                <th scope="col">Stat</th>
                <th scope="col" id="iv-head">@EditorText.IvHeader(Draft.MaxIv)</th>
                <th scope="col" id="ev-head">@EditorText.EvHeader(Draft.MaxEv)</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < EditorDraft.StatCount; i++)
            {
                var stat = i;
                <tr>
                    <th scope="row" id="stat-@stat">@InspectorText.StatName(stat, NatureEffect.Of(Draft.Nature))</th>
                    <td><input id="iv-@stat" type="text" inputmode="numeric" autocomplete="off" value="@ivs[stat]" aria-labelledby="stat-@stat iv-head"
                               @oninput="e => IvTyped(stat, e)" readonly="@(!Can(EditableFields.Ivs))" /></td>
                    <td><input id="ev-@stat" type="text" inputmode="numeric" autocomplete="off" value="@evs[stat]" aria-labelledby="stat-@stat ev-head"
                               @oninput="e => EvTyped(stat, e)" readonly="@(!Can(EditableFields.Evs))" /></td>
                </tr>
            }
        </tbody>
    </table>
    @* Always rendered, so a screen reader announces a change of their text. *@
    <p id="iv-note" role="status">@EditorText.IvNote(Draft.IvTotal, Draft.MaxIv, HiddenPowerName)</p>
    <p id="ev-note" role="status">@EditorText.EvNote(Draft.EvTotal, Draft.MaxEvTotal)</p>
</fieldset>
<fieldset id="item-fields">
    <legend>Held item</legend>
    <label for="held-item">Held item</label>
    <ChoiceSelect Id="held-item" Items="Draft.Capabilities.Lists.Items" Value="heldItem" Disabled="!Can(EditableFields.HeldItem)" DescribedBy="item-note"
                  Unlisted="UnlistedItem" OnChange="ItemChanged" />
    <p id="item-note">@EditorText.ItemNote</p>
</fieldset>
<fieldset id="move-fields">
    <legend>Moves</legend>
    @* A move box lists every move of the game; choosing one sets that slot's PP as the desktop does (see EditorDraft.EditMove), and the note
       below says what it did. PP is text with a numeric keyboard, as for friendship, refused above the move's PP and never clamped. Each field
       is named by its row and column headers ("Move 2 PP"). *@
    <table class="stat-edit move-edit">
        <thead>
            <tr>
                <th scope="col" class="col-slot">Slot</th>
                <th scope="col" id="move-head">Move</th>
                <th scope="col" class="col-pp" id="pp-head">PP</th>
                <th scope="col" class="col-ppups" id="ppups-head">@EditorText.PpUpsHeader(EditorDraft.MaxPpUps)</th>
                <th scope="col" class="col-max" id="maxpp-head">Max PP</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < EditorDraft.MoveCount; i++)
            {
                var slot = i;
                var current = moves[slot];
                <tr>
                    <th scope="row" id="slot-@slot">@EditorText.MoveSlotName(slot)</th>
                    <td>
                        <ChoiceSelect Id="@($"move-{slot}")" LabelledBy="@($"slot-{slot} move-head")" Items="Draft.Capabilities.Lists.Moves" Value="current.Move"
                                      Disabled="!Can(EditableFields.Moves)" Unlisted="UnlistedMove" OnChange="v => MoveChanged(slot, v)" />
                    </td>
                    <td><input id="pp-@slot" type="text" inputmode="numeric" autocomplete="off" value="@pp[slot]" aria-labelledby="slot-@slot pp-head"
                               @oninput="e => PpTyped(slot, e)" readonly="@(!Can(EditableFields.Pp) || current.IsEmpty)" /></td>
                    <td>
                        @* A move that cannot take PP Ups offers only 0 and its stored count, and is enabled only while some are stored, so they
                           can be removed and no choice is refused. *@
                        <select id="ppups-@slot" value="@current.PpUps.ToString(CultureInfo.InvariantCulture)" aria-labelledby="slot-@slot ppups-head" @onchange="e => PpUpsChanged(slot, e)"
                                disabled="@(!Can(EditableFields.Pp) || current.IsEmpty || (!current.CanTakePpUps && current.PpUps == 0))">
                            @if (current.PpUps > EditorDraft.MaxPpUps)
                            {
                                <option value="@current.PpUps" disabled>@EditorText.UnlistedPpUps(current.PpUps)</option>
                            }
                            @for (var u = 0; u <= EditorDraft.MaxPpUps; u++)
                            {
                                var ups = u;
                                if (ups != 0 && ups != current.PpUps && !current.CanTakePpUps)
                                {
                                    continue;
                                }
                                <option value="@ups">@ups.ToString(CultureInfo.InvariantCulture)</option>
                            }
                        </select>
                    </td>
                    <td id="maxpp-@slot">@current.MaxPp.ToString(CultureInfo.InvariantCulture)</td>
                </tr>
            }
        </tbody>
    </table>
    @* Always rendered, so a screen reader announces a change of its text. *@
    <p id="move-note" role="status">@EditorText.MoveChangeNote(moveChange, MoveName)</p>
    <p id="move-list-note">@EditorText.MoveListNote</p>
</fieldset>

@code {
    /// <summary>The draft being edited. A new draft (another slot, or after apply or cancel) reloads every field.</summary>
    [Parameter, EditorRequired] public EditorDraft Draft { get; set; } = null!;

    /// <summary>
    /// Runs one edit on the draft. The owner applies it, makes legality stale and reports a refusal, which leaves the draft unchanged.
    /// </summary>
    [Parameter, EditorRequired] public EventCallback<Action<EditorDraft>> OnEdit { get; set; }

    private EditorDraft? shown;
    private string nickname = "", trainerFriendship = "", handlerFriendship = "", level = "", experience = "";
    private readonly string[] ivs = new string[EditorDraft.StatCount], evs = new string[EditorDraft.StatCount];
    private readonly string[] pp = new string[EditorDraft.MoveCount];
    private IReadOnlyList<MoveSlot> moves = [];
    private bool nicknamed;
    private int language, nature, heldItem, abilitySlot, gender;

    /// <summary>
    /// Told whether a species or form change is being previewed, so the owner can hold back Apply and Download, which would not carry the
    /// choice the boxes show.
    /// </summary>
    [Parameter] public EventCallback<bool> OnPreviewChanged { get; set; }

    /// <summary>The number of refused species or form choices, which keys the two boxes so a refusal resets them (see the markup).</summary>
    private int refusals;

    /// <summary>The species box's key: distinct from the form box's, as sibling keys must be.</summary>
    private string SpeciesKey => string.Create(CultureInfo.InvariantCulture, $"species-{refusals}");

    /// <summary>The form box's key.</summary>
    private string FormKey => string.Create(CultureInfo.InvariantCulture, $"form-{refusals}");

    /// <summary>The species select, focused again once the confirmation buttons it led to are gone.</summary>
    private ChoiceSelect? speciesSelect;

    /// <summary>The species or form change being previewed, or null when none is: the boxes then show the draft's species and form.</summary>
    private SpeciesFormPreview? preview;

    /// <summary>Why the last species or form choice could not be previewed, or null.</summary>
    private SessionError? previewRefusal;

    /// <summary>What the last edit, a confirmed species or form change, changed; null when the last edit was not one.</summary>
    private IReadOnlyList<string>? speciesChange;

    /// <summary>What the last gender edit changed besides the gender (the form and what follows it), or null when the last edit was not one that did.</summary>
    private GenderChange? genderChange;

    /// <summary>What the last edit did to a move slot's PP, or null when the last edit changed no move or PP Ups.</summary>
    private MoveChange? moveChange;

    /// <summary>The name before and after the last edit gave the Pokémon its default name, or null when the last edit did not.</summary>
    private (string From, string To)? renamed;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(shown, Draft))
        {
            shown = Draft;
            renamed = null;
            moveChange = null;
            genderChange = null;
            preview = null;
            previewRefusal = null;
            speciesChange = null;
            Array.Fill(pp, "");
            trainerFriendship = handlerFriendship = level = experience = "";
            Array.Fill(ivs, "");
            Array.Fill(evs, "");
            Load();
        }
    }

    /// <summary>Shows the draft's values in every field, replacing any refused input.</summary>
    private void Load()
    {
        nickname = Draft.Nickname;
        nicknamed = Draft.IsNicknamed;
        language = Draft.Language;
        trainerFriendship = Shown(trainerFriendship, Draft.TrainerFriendship);
        handlerFriendship = Shown(handlerFriendship, Draft.HandlerFriendship);
        level = Shown(level, Draft.Level);
        experience = Shown(experience, Draft.Experience);
        nature = (int)Draft.Nature;
        var draftedIvs = Draft.Ivs;
        var draftedEvs = Draft.Evs;
        for (var i = 0; i < EditorDraft.StatCount; i++)
        {
            ivs[i] = Shown(ivs[i], draftedIvs[i]);
            evs[i] = Shown(evs[i], draftedEvs[i]);
        }
        abilitySlot = Draft.AbilitySlot ?? UnmatchedAbilitySlot;
        gender = Draft.Gender;
        heldItem = Draft.HeldItem;
        moves = Draft.Moves;
        for (var i = 0; i < EditorDraft.MoveCount; i++)
        {
            pp[i] = Shown(pp[i], moves[i].Pp);
        }
    }

    /// <summary>
    /// The text for a number field: the typed text when it already reads as the drafted value (such as "070"), so accepting it does not
    /// rewrite the field under the cursor, and the drafted value otherwise.
    /// </summary>
    private static string Shown(string typed, long value) =>
        long.TryParse(typed, NumberStyles.None, CultureInfo.InvariantCulture, out var parsed) && parsed == value
            ? typed
            : value.ToString(CultureInfo.InvariantCulture);

    private bool Can(EditableFields field) => Draft.Editable.HasFlag(field);

    private bool Listed(int value) => Draft.Capabilities.Lists.Languages.Any(l => l.Value == value);

    private bool ListedNature(int value) => Draft.Capabilities.Lists.Natures.Any(n => n.Value == value);

    /// <summary>The ability box's value for a stored ability and slot number that do not name one of the slots together; no slot has it.</summary>
    private const int UnmatchedAbilitySlot = -1;

    /// <summary>The stored ability and slot, named as the inspector names them, when they do not name one of the slots together.</summary>
    private string UnmatchedAbility(int _) =>
        EditorText.UnmatchedAbility(EntityInspection.Listed(Draft.Ability, Draft.Capabilities.Lists.Abilities, GameInfo.Strings.abilitylist), Draft.AbilityNumber);

    /// <summary>The species the species box shows: the previewed one, or the drafted one.</summary>
    private int ShownSpecies => preview?.After.Species ?? Draft.Species;

    /// <summary>The form the form box shows: the previewed one, or the drafted one.</summary>
    private int ShownForm => preview?.After.Form ?? Draft.Form;

    /// <summary>The forms the form box lists: the previewed species', or the drafted species'.</summary>
    private IReadOnlyList<FormChoice> ShownForms => preview?.Forms ?? Draft.FormChoices;

    /// <summary>A stored species outside the game's list, named as the inspector names it.</summary>
    private string UnlistedSpecies(int value) => InspectorText.Species(EntityInspection.Listed(value, Draft.Capabilities.Lists.Species, GameInfo.Strings.specieslist));

    /// <summary>The species' name from the game's list, or, for a stored species outside it, the name the inspector gives it.</summary>
    private string SpeciesName(ushort species) => Draft.Capabilities.SpeciesChoices.FirstOrDefault(s => s.Value == species)?.Text ?? UnlistedSpecies(species);

    /// <summary>
    /// Names the form before (false) or after (true) <paramref name="change"/>, from the drafted species' and the new species' form lists, or
    /// null for a species without alternate forms.
    /// </summary>
    private Func<bool, string?> FormNameOf(SpeciesFormPreview change)
    {
        var before = Draft.FormChoices;
        return after => after ? Named(change.Forms, change.After.Form) : Named(before, change.Before.Form);

        static string? Named(IReadOnlyList<FormChoice> forms, byte form) => forms.Count == 0
            ? null
            : form < forms.Count ? EditorText.FormName(forms[form]) : EditorText.UnlistedForm(form);
    }

    /// <summary>The ability's name, as the inspector names it.</summary>
    private string AbilityName(int ability) => InspectorText.Named(EntityInspection.Listed(ability, Draft.Capabilities.Lists.Abilities, GameInfo.Strings.abilitylist));

    /// <summary>A stored item outside the game's list, named as the inspector names it.</summary>
    private string UnlistedItem(int value) => EditorText.Unlisted(EntityInspection.Listed(value, Draft.Capabilities.Lists.Items, GameInfo.Strings.itemlist));

    /// <summary>A stored move outside the game's list, named as the inspector names it.</summary>
    private string UnlistedMove(int value) => EditorText.Unlisted(EntityInspection.Listed(value, Draft.Capabilities.Lists.Moves, GameInfo.Strings.movelist));

    /// <summary>The move's name from Core's list, or, for a stored move outside it, the name the inspector gives it.</summary>
    private string MoveName(ushort move) => Draft.Capabilities.Lists.Moves.FirstOrDefault(m => m.Value == move)?.Text ?? UnlistedMove(move);

    /// <summary>The name Core gives the drafted Hidden Power type, or null for a type it has no name for.</summary>
    private string? HiddenPowerName
    {
        get
        {
            var names = GameInfo.Strings.HiddenPowerTypes;
            var type = Draft.HiddenPowerType;
            return (uint)type < (uint)names.Length ? names[type] : null;
        }
    }

    /// <summary>The language's name from Core's list, or the unknown wording for a stored value outside it.</summary>
    private string LanguageName => Draft.Capabilities.Lists.Languages.FirstOrDefault(l => l.Value == Draft.Language)?.Text ?? EditorText.UnlistedLanguage(Draft.Language);

    private Task NicknameTyped(ChangeEventArgs e)
    {
        nickname = e.Value?.ToString() ?? "";
        var text = nickname;
        return Run(d => d.TypeNickname(text), tracksRename: false);
    }

    private Task FlagChanged(ChangeEventArgs e)
    {
        nicknamed = e.Value is true;
        var flag = nicknamed;
        return Run(d => d.SetNicknamed(flag), tracksRename: true);
    }

    private Task LanguageChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var value))
        {
            return Task.CompletedTask;
        }
        language = value;
        return Run(d => d.EditLanguage(value), tracksRename: true);
    }

    private Task TrainerFriendshipTyped(ChangeEventArgs e)
    {
        trainerFriendship = e.Value?.ToString() ?? "";
        return Run(Friendship(trainerFriendship, static (d, v) => d.EditTrainerFriendship(v)), tracksRename: false);
    }

    private Task HandlerFriendshipTyped(ChangeEventArgs e)
    {
        handlerFriendship = e.Value?.ToString() ?? "";
        return Run(Friendship(handlerFriendship, static (d, v) => d.EditHandlerFriendship(v)), tracksRename: false);
    }

    private Task LevelTyped(ChangeEventArgs e)
    {
        level = e.Value?.ToString() ?? "";
        return Run(Number(level, SessionError.LevelOutOfRange, static (d, v) => d.EditLevel((int)Math.Min(v, int.MaxValue))), tracksRename: false);
    }

    private Task ExperienceTyped(ChangeEventArgs e)
    {
        experience = e.Value?.ToString() ?? "";
        return Run(Number(experience, SessionError.ExperienceOutOfRange, static (d, v) => d.EditExperience(v)), tracksRename: false);
    }

    private Task IvTyped(int stat, ChangeEventArgs e)
    {
        ivs[stat] = e.Value?.ToString() ?? "";
        return Run(Number(ivs[stat], SessionError.IvOutOfRange, (d, v) => d.EditIv(stat, (int)Math.Min(v, int.MaxValue))), tracksRename: false);
    }

    private Task EvTyped(int stat, ChangeEventArgs e)
    {
        evs[stat] = e.Value?.ToString() ?? "";
        return Run(Number(evs[stat], SessionError.EvOutOfRange, (d, v) => d.EditEv(stat, (int)Math.Min(v, int.MaxValue))), tracksRename: false);
    }

    private Task NatureChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var value))
        {
            return Task.CompletedTask;
        }
        nature = value;
        return Run(d => d.EditNature(value), tracksRename: false);
    }

    /// <summary>
    /// Previews a change to the chosen species, in its first form. Choosing the drafted species again is no change and ends the preview, even
    /// when its stored form is one its list does not offer.
    /// </summary>
    private Task SpeciesChosen(int species) => species == Draft.Species ? Show(null, null) : Preview(species, 0);

    /// <summary>Previews a change to the chosen form of the species the species box shows.</summary>
    private Task FormChosen(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var form)
            ? Preview(ShownSpecies, form)
            : Task.CompletedTask;

    /// <summary>
    /// Shows what changing to <paramref name="species"/> and <paramref name="form"/> would do, without changing the draft. Choosing the drafted
    /// species and form ends the preview; a refused choice is reported in its place and the boxes show the draft again.
    /// </summary>
    private Task Preview(int species, int form)
    {
        SpeciesFormPreview change;
        try
        {
            change = Draft.PreviewSpeciesForm(species, form);
        }
        catch (SessionException ex)
        {
            refusals++;
            return Show(null, ex.Error);
        }
        return Show(change.IsNoChange ? null : change, null);
    }

    /// <summary>Shows <paramref name="change"/> (or no preview) and <paramref name="refusal"/>, telling the owner when a preview starts or ends.</summary>
    private Task Show(SpeciesFormPreview? change, SessionError? refusal)
    {
        var was = preview is not null;
        preview = change;
        previewRefusal = refusal;
        return was == (change is not null) ? Task.CompletedTask : OnPreviewChanged.InvokeAsync(change is not null);
    }

    /// <summary>Makes the previewed change, then returns focus to the species box, since the buttons are gone.</summary>
    private async Task ConfirmSpeciesForm()
    {
        if (preview is not { } change)
        {
            return;
        }
        // The note is written now, while the form names before the change can still be read from the draft.
        var changes = EditorText.SpeciesFormChanges(change, SpeciesName, FormNameOf(change), AbilityName);
        await Run(d => d.EditSpeciesForm(change.After.Species, change.After.Form), tracksRename: false, speciesChanges: changes);
        await FocusSpecies();
    }

    /// <summary>Drops the preview, so the boxes show the draft again, and returns focus to the species box.</summary>
    private async Task CancelSpeciesForm()
    {
        await Show(null, null);
        await FocusSpecies();
    }

    private async Task FocusSpecies()
    {
        if (speciesSelect is not null)
        {
            await speciesSelect.FocusAsync();
        }
    }

    private Task AbilityChanged(int value) => Run(d => d.EditAbilitySlot(value), tracksRename: false);

    private Task GenderChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var value))
        {
            return Task.CompletedTask;
        }
        return Run(d => d.EditGender(value), tracksRename: false, tracksForm: true);
    }

    private Task ItemChanged(int value) => Run(d => d.EditHeldItem(value), tracksRename: false);

    private Task MoveChanged(int slot, int value) => Run(d => d.EditMove(slot, value), tracksRename: false, moveSlot: slot);

    private Task PpUpsChanged(int slot, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var value))
        {
            return Task.CompletedTask;
        }
        return Run(d => d.EditPpUps(slot, value), tracksRename: false, moveSlot: slot);
    }

    private Task PpTyped(int slot, ChangeEventArgs e)
    {
        pp[slot] = e.Value?.ToString() ?? "";
        return Run(Number(pp[slot], SessionError.PpOutOfRange, (d, v) => d.EditPp(slot, (int)Math.Min(v, int.MaxValue))), tracksRename: false);
    }

    /// <summary>
    /// The edit for typed level, experience, IV, EV or PP text. Text that is not a whole number (an empty field, a sign, a fraction or more digits than
    /// fit) is refused with <paramref name="refusal"/>, like a value out of range, so nothing is guessed or clamped.
    /// </summary>
    private static Action<EditorDraft> Number(string text, SessionError refusal, Action<EditorDraft, long> edit) =>
        long.TryParse(text, NumberStyles.None, CultureInfo.InvariantCulture, out var value)
            ? d => edit(d, value)
            : _ => throw new SessionException(refusal);

    /// <summary>
    /// The edit for typed friendship text. Text that is not a whole number (an empty field, a sign or a fraction) is refused like a value out
    /// of range, so nothing is guessed or clamped.
    /// </summary>
    private static Action<EditorDraft> Friendship(string text, Action<EditorDraft, int> edit) =>
        int.TryParse(text, NumberStyles.None, CultureInfo.InvariantCulture, out var value)
            ? d => edit(d, value)
            : _ => throw new SessionException(SessionError.FriendshipOutOfRange);

    /// <summary>
    /// Runs <paramref name="edit"/> through <see cref="OnEdit"/>. An accepted edit reloads every field from the draft, so a flag or language
    /// change shows the name it gave, and earlier refused input is replaced by what the draft holds. A refused edit leaves the input as typed.
    /// </summary>
    /// <param name="edit">The draft edit.</param>
    /// <param name="tracksRename">True for an edit that may give the Pokémon its default name, which the name note then reports.</param>
    /// <param name="moveSlot">The move slot of a move or PP Ups edit, whose effect on the slot's PP the move note then reports.</param>
    /// <param name="tracksForm">True for a gender edit, which may change the form and what follows it; the gender note then reports it.</param>
    /// <param name="speciesChanges">For a confirmed species or form change, what it changes, which the species note then reports.</param>
    private async Task Run(Action<EditorDraft> edit, bool tracksRename, int? moveSlot = null, bool tracksForm = false, IReadOnlyList<string>? speciesChanges = null)
    {
        var draft = Draft;
        var revision = draft.EditRevision;
        var before = draft.Nickname;
        var slotBefore = moveSlot is { } s ? draft.Moves[s] : null;
        var dependentsBefore = draft.Dependents;
        await OnEdit.InvokeAsync(edit);
        if (!ReferenceEquals(draft, Draft) || draft.EditRevision == revision)
        {
            return;
        }
        renamed = tracksRename && draft.Nickname != before ? (before, draft.Nickname) : null;
        moveChange = moveSlot is { } changed && slotBefore is not null
            ? MoveChange.Between(changed, slotBefore, draft.Moves[changed], draft.StoredMoves[changed])
            : null;
        genderChange = tracksForm ? GenderChange.Between(dependentsBefore, draft.Dependents) : null;
        speciesChange = speciesChanges;
        // A preview describes the draft it was taken from, so any accepted edit ends it.
        Load();
        await Show(null, null);
    }
}
