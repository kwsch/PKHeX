@* Read-only view of the drafted entity, in fixed sections. Every value is rendered as text, so a hostile nickname or trainer name stays inert. *@
<div id="inspector" class="inspector">
    @* Not named "section": older Razor compilers read "@section" as the section directive. *@
    @foreach (var group in sections)
    {
        <section aria-labelledby="@group.Id">
            <h3 id="@group.Id">@group.Title</h3>
            @if (group.Table is { } table)
            {
                <table id="@table.Id">
                    <caption>@table.Caption</caption>
                    <thead>
                        <tr>
                            @foreach (var header in table.Headers)
                            {
                                <th scope="col">@header</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in table.Rows)
                        {
                            <tr>
                                <th scope="row">@row[0]</th>
                                @for (var i = 1; i < row.Count; i++)
                                {
                                    <td>@row[i]</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <dl class="overview">
                @foreach (var row in group.Rows)
                {
                    <dt>@row.Label</dt>
                    <dd id="@row.Id">@row.Value</dd>
                }
            </dl>
        </section>
    }
</div>

@code {
    private IReadOnlyList<InspectorSection> sections = [];

    /// <summary>The entity to show. Pass a new value after every draft change, so the view always matches the draft.</summary>
    [Parameter, EditorRequired]
    public EntityInspection Inspection { get; set; } = null!;

    /// <inheritdoc />
    protected override void OnParametersSet() => sections = InspectorText.Sections(Inspection);
}
