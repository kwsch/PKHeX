@inject BrowserFileService Files
@inject WorkspaceState State
@inject TimeProvider Clock
@inject DiagnosticLog Diagnostics
@inject BrowserPage Page
@implements IDisposable

@* The open/edit/download journey. Session state lives in WorkspaceState, so recovering from a fault here keeps the open save. *@
@if (Session is null)
{
    <StartScreen />
}
@* One picker in a fixed place for opening and replacing, so it keeps its drop-zone registration when a save is opened. *@
@* Focusable only from script: focus lands here after an exit ends, so it never drops to the page body. *@
<h2 id="open-title" tabindex="-1" @ref="openTitle">@(Session is null ? "Open a save file" : "Open another save file")</h2>
<SaveFilePicker Disabled="busy" OnReadStarted="() => busy = true" OnRead="OpenFile" OnDropRejected="DropRejected" />
<p id="message" role="status">@message</p>
<SessionExitPanel Exit="State.Exit" Stage="State.ExitStage" CanApplyDraft="@(Draft is { CanApply: true } && State.DraftValid && !Previewing)"
                  ApplyGate="State.Legality.Gate" ApplyVerdict="AcknowledgedVerdict" Flagged="Flagged" ExportAcknowledged="!(Session?.ExportNeedsAcknowledgement ?? false)"
                  DraftPending="@(State.DraftDirty || !State.DraftValid)" ExportStatus="@(Session?.ExportStatus ?? ExportStatus.Unchanged)"
                  Busy="busy" OnApplyDraft="ApplyDraftForExit" OnDiscardDraft="DiscardDraftForExit" OnExport="() => ExportAsync()"
                  OnContinue="ContinueExit" OnDiscardSession="DiscardSessionForExit" OnCancel="CancelExit"
                  OnAcknowledgeApply="AcknowledgeLegality" OnAcknowledgeExport="AcknowledgeExport" />
@if (Session is not null)
{
    @* Two panes, side by side on a wide screen. A medium screen can fold the storage pane away while a Pokémon is open; a narrow one shows one
       pane at a time, with a return action. The DOM order is the reading and tab order at every width; only the CSS places the panes, so a
       resize never re-renders anything or loses the selection or the draft (see WorkspaceView). *@
    <div id="workspace-panes" class="workspace-panes" data-pane="@(View.Pane == WorkspacePane.Editor ? "editor" : "storage")"
         data-storage-collapsed="@(View.StorageCollapsed ? "true" : null)">
        <div id="pane-storage" class="pane-storage">
            @* When one pane is shown at a time, the way back to an open draft from wherever the user has browsed: its slot may be in a box not shown,
               and every other slot refuses to open while it has changes. *@
            @if (Draft is not null)
            {
                <button id="editor-resume" type="button" class="narrow-only" @onclick="ResumeEditor">@WorkspaceLayout.ResumeEditor</button>
            }
            <SaveOverviewPanel Session="Session" />
            <p id="session-state">@SessionStatusText.Changes(Session)</p>
            <p id="session-note">This save is processed only on this device. Changes are temporary until you download them; reloading or closing the tab discards this session.</p>
            <StorageBrowser Session="Session" Selected="Draft?.Slot" OnActivate="OpenSlot" />
        </div>
        @if (Draft is not null)
        {
            <section id="pane-editor" class="pane-editor" aria-labelledby="draft-title">
                @* Each is shown only at the width it serves: the return action when one pane is shown at a time, the fold when both fit only narrowly. *@
                <button id="editor-return" type="button" class="narrow-only" @onclick="ReturnToStorage">@WorkspaceLayout.ReturnToStorage</button>
                <button id="storage-toggle" type="button" class="medium-only" aria-controls="pane-storage" aria-expanded="@(View.StorageCollapsed ? "false" : "true")"
                        @onclick="View.ToggleStorage">@WorkspaceLayout.StorageToggle</button>
                <h2 id="draft-title" tabindex="-1">Selected Pokémon</h2>
                <p id="draft-slot">@SlotText.Position(Draft.Slot)</p>
                <DraftEditor Draft="Draft" OnEdit="Edit" OnPreviewChanged="shown => previewing = shown ? Draft : null" />
                <p id="draft-state">@(State.DraftDirty ? "Unapplied draft" : "No draft changes")</p>
                <PartyHpPreview Change="Draft.HpChange" />
                @if (Previewing)
                {
                    <p id="species-pending">@EditorText.SpeciesFormPending</p>
                }
                @if (Draft.CanApply && State.DraftDirty && State.DraftValid && !Previewing)
                {
                    <ApplyAcknowledgement Id="apply-ack" Gate="State.Legality.Gate" Verdict="AcknowledgedVerdict" Disabled="busy" OnAcknowledge="AcknowledgeLegality" />
                }
                <button id="apply" @onclick="Apply" disabled="@(!Draft.CanApply || !State.DraftDirty || !State.DraftValid || Previewing || !LegalityAllowsApply)">Apply changes</button>
                <button id="cancel-draft" @onclick="CancelDraft">Cancel draft</button>
                @if (!Draft.CanApply)
                {
                    <p id="party-note">@UserMessages.For(SessionError.PartyApplyNotAvailable) Legality is analysed as a party member.</p>
                }
                <LegalityPanel Status="State.Legality.Status" Current="State.Legality.Current" AutoRun="State.Legality.AutoRun"
                               Running="State.Legality.IsRunning"
                               DraftValid="State.DraftValid" OnAnalyze="Analyze" OnShowSection="ShowSection" />
                @if (inspection is not null)
                {
                    <p id="inspector-note">Read-only details of the drafted Pokémon, including accepted unapplied changes (a refused edit is not shown). Other fields are kept exactly as stored.</p>
                    <EntityInspector Inspection="inspection" />
                }
            </section>
        }
        <section id="pane-download" class="pane-download" aria-labelledby="download-title">
            <h2 id="download-title">Download</h2>
            <p id="export-state">@SessionStatusText.For(Session.ExportStatus)</p>
            <fieldset id="download-name">
                <legend>File name</legend>
                @foreach (var choice in Enum.GetValues<ExportNameChoice>())
                {
                    var id = $"name-{choice.ToString().ToLowerInvariant()}";
                    <label class="check" for="@id">
                        <input id="@id" type="radio" name="download-name" checked="@(NameChoice == choice)" @onchange="() => nameChoice = choice" />
                        @SessionStatusText.NameOption(choice, ExportNaming.NameFor(Session, choice, LocalNow))
                    </label>
                }
            </fieldset>
            @if (ExportNaming.NeedsRenameToRestore(ExportNaming.NameFor(Session, NameChoice, LocalNow)))
            {
                <p id="rename-note">@SessionStatusText.RenameToRestore</p>
            }
            <ExportAcknowledgement Id="export-ack" Flagged="Flagged" Acknowledged="!Session.ExportNeedsAcknowledgement" Disabled="busy" OnAcknowledge="AcknowledgeExport" />
            <button id="download" @onclick="() => ExportAsync()" disabled="@(State.DraftDirty || busy || !State.DraftValid || Previewing || Session.ExportNeedsAcknowledgement)">Download validated save</button>
            <p>Your browser may adjust the name. Download initiation does not confirm it was saved to disk. Verify your file before closing.</p>
        </section>
        <section id="pane-session" class="pane-session" aria-labelledby="session-title">
            <h2 id="session-title">Session</h2>
            <button id="close-session" type="button" @ref="closeButton" @onclick="RequestClose" disabled="@busy">Close save</button>
            <button id="reset-session" type="button" @ref="resetButton" @onclick="RequestReset" disabled="@(busy || !Session.HasChangesSinceOpen)">Reset to original</button>
            <button id="discard-session" type="button" @ref="discardButton" @onclick="RequestDiscard" disabled="@busy">Discard session</button>
            <p id="reset-note">@SessionStatusText.ResetNote</p>
            <p id="discard-note">@SessionStatusText.DiscardNote</p>
        </section>
    </div>
}

@code {
    private string message = "";

    /// <summary>The draft whose editor is previewing a species or form change, or null; a later draft has no preview.</summary>
    private EditorDraft? previewing;

    /// <summary>
    /// True while the editor previews a species or form change it has not made: its boxes show the previewed choice, which neither Apply nor
    /// Download would carry, so both wait until it is made or dropped.
    /// </summary>
    private bool Previewing => previewing is not null && ReferenceEquals(previewing, Draft);

    /// <summary>The message shown for the last refused edit, cleared from the page once a later edit is accepted.</summary>
    private string? refusal;
    private bool busy;
    private ExportNameChoice? nameChoice;

    /// <summary>The inspector's view of the draft, rebuilt when the draft changes rather than on every render.</summary>
    private EntityInspection? inspection;
    private ElementReference openTitle, closeButton, resetButton, discardButton;

    /// <summary>The intent of the exit whose panel was in the last render and the session it was leaving, or null when none was shown.</summary>
    private (ExitIntent Intent, SaveSession? Session)? shownExit;

    /// <summary>
    /// True when a close, reset or discard has just completed at once, without a panel. The button that asked for it is gone (or belongs to the
    /// new session's controls), so focus moves to the open heading rather than dropping to the page body.
    /// </summary>
    private bool focusOpenTitle;

    /// <summary>The session's flagged changes, or none without a session.</summary>
    private IReadOnlyDictionary<SlotRef, LegalityVerdict> Flagged => Session?.FlaggedChanges ?? new Dictionary<SlotRef, LegalityVerdict>();

    /// <summary>The verdict the user is asked to acknowledge before applying, when the gate asks for one.</summary>
    private LegalityVerdict AcknowledgedVerdict => State.Legality.Current?.Verdict ?? LegalityVerdict.Unavailable;

    /// <summary>True when legality lets the draft as it is now be applied: Valid, or an acknowledged Invalid or Unavailable result.</summary>
    private bool LegalityAllowsApply => State.Legality.Gate is LegalityGate.Clear or LegalityGate.Acknowledged;
    private SaveSession? Session => State.Session;
    private EditorDraft? Draft => State.Draft;
    private WorkspaceView View => State.View;

    /// <summary>Where focus moves after the next render, when a pane change hides the element that had it.</summary>
    private PaneFocus pendingFocus;

    /// <summary>A focus move a pane change asks for, made once the new pane has rendered.</summary>
    private enum PaneFocus
    {
        /// <summary>Focus stays where it is.</summary>
        None,

        /// <summary>A slot was opened: on a narrow screen the storage pane, and the slot with it, is now hidden, so focus moves to the editor.</summary>
        Editor,

        /// <summary>The return action hid the editor, and the button with it: focus moves back to the selected slot.</summary>
        Storage,
    }

    /// <summary>The user's name choice, or the default for the session's state until they pick one.</summary>
    private ExportNameChoice NameChoice => nameChoice ?? ExportNaming.DefaultFor(Session!);

    /// <summary>The user's local date and time, in the browser's time zone.</summary>
    private DateTime LocalNow => Clock.GetLocalNow().DateTime;

    /// <summary>
    /// When an exit's panel has just gone, moves focus out of the removed panel, which would otherwise leave it on the page body:
    /// back to the button that started a close, reset or discard when it was cancelled (the session is still the one it was leaving), and
    /// otherwise to the open heading, above the status message that reports the outcome.
    /// An exit that completed at once never showed a panel; focus moves to the open heading too (<see cref="focusOpenTitle"/>).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await MovePaneFocusAsync();
        if (focusOpenTitle)
        {
            focusOpenTitle = false;
            shownExit = null;
            await openTitle.FocusAsync();
            return;
        }
        (ExitIntent, SaveSession?)? shown = State.Exit is { } exit ? (exit.Intent, Session) : null;
        var ended = shownExit;
        shownExit = shown;
        if (ended is not { } left || shown is not null)
        {
            return;
        }
        var kept = Session is not null && ReferenceEquals(Session, left.Session);
        var target = !kept ? openTitle : left.Intent switch
        {
            ExitIntent.Close => closeButton,
            ExitIntent.Reset => resetButton,
            ExitIntent.Discard => discardButton,
            _ => openTitle,
        };
        await target.FocusAsync();
    }

    /// <summary>
    /// Makes the focus move a pane change asked for. Opening a slot moves focus only on a narrow screen, where the slot it came from is now
    /// hidden; on a wider one both panes are shown and focus stays in the grid, as before. The return action exists only on a narrow screen.
    /// </summary>
    private async Task MovePaneFocusAsync()
    {
        var target = pendingFocus;
        pendingFocus = PaneFocus.None;
        try
        {
            switch (target)
            {
                case PaneFocus.Editor:
                    await Page.FocusIfNarrowAsync(WorkspaceLayout.EditorHeadingId);
                    break;
                case PaneFocus.Storage when Draft is { } draft:
                    await Page.FocusAsync(WorkspaceLayout.SlotElementId(draft.Slot, State.ShowAsList, State.CurrentBox) ?? WorkspaceLayout.StorageHeadingId);
                    break;
            }
        }
        catch (JSException ex)
        {
            Diagnostics.Record(DiagnosticOperation.Focus, ex);
        }
    }

    /// <summary>The narrow layout's way back to the open draft: shows its editor again and focuses the editor's heading.</summary>
    private void ResumeEditor()
    {
        View.ShowEditor();
        pendingFocus = PaneFocus.Editor;
    }

    /// <summary>The narrow layout's return action: shows the party and boxes again, keeping the draft, and focuses the selected slot.</summary>
    private void ReturnToStorage()
    {
        View.ShowStorage();
        pendingFocus = PaneFocus.Storage;
    }

    protected override void OnInitialized()
    {
        // Results complete after an await, outside any event handler, so the page re-renders when the legality state says it changed.
        State.Legality.Changed += LegalityChanged;
        State.Legality.AnalysisFailed += AnalysisFailed;
        State.Legality.Yield = WaitForPaintAsync;
        // A new instance with a session already open means the workspace was recovered after a fault.
        message = Session is null ? "Choose a save to begin." : "The open save was kept. Any unapplied draft was discarded.";
    }

    private void OpenFile(FileReadResult file)
    {
        busy = false;
        // The candidate is fully parsed and checked before anything is touched, so a failure keeps the session, draft and any exit in progress.
        var outcome = file.Open();
        switch (State.Accept(outcome))
        {
            case OpenDisposition.Opened:
                Opened();
                break;
            case OpenDisposition.Held:
                message = "Resolve the open session before the new file is opened.";
                break;
            default:
                Diagnostics.Record(DiagnosticOperation.Open, DiagnosticCode.For(outcome));
                message = UserMessages.For(outcome) + Retained + StillWaiting;
                break;
        }
    }

    private void DropRejected(DropRejection rejection) =>
        message = UserMessages.For(rejection) + (rejection == DropRejection.Busy ? "" : Retained);

    /// <summary>Appended to refusals, but only when there is a session that the refusal left untouched.</summary>
    private string Retained => Session is null ? "" : " The previous session was retained.";

    /// <summary>Appended to a refused open while an earlier file still waits to replace the session, so the two are not confused.</summary>
    private string StillWaiting => State.Exit?.Candidate is { } waiting ? $" {DisplayText.Embed(waiting.FileName)} is still waiting to replace it." : "";

    private const string Loaded = "Save loaded locally; checksums valid.";

    /// <summary>Resets the editor and name choice for a session that has just been opened.</summary>
    private void Opened()
    {
        nameChoice = null;
        ResetDraftView();
        message = Loaded;
    }

    /// <summary>Reports what an exit step did: the new or reset session, the start screen, or the step that is now waiting.</summary>
    /// <param name="before">The session before the step.</param>
    /// <param name="intent">The exit the step belonged to, which names the outcome once the exit has completed.</param>
    private void AfterExitStep(SaveSession? before, ExitIntent? intent)
    {
        if (State.Exit is not null)
        {
            ResetDraftView();
            return;
        }
        // No panel was shown for a request that completed at once, so nothing else moves focus off the button that asked for it.
        focusOpenTitle = shownExit is null && !ReferenceEquals(Session, before);
        if (Session is null)
        {
            nameChoice = null;
            ResetDraftView();
            message = intent == ExitIntent.Discard ? SessionStatusText.Discarded : "Save closed. Choose a save to begin.";
        }
        else if (!ReferenceEquals(Session, before))
        {
            Opened();
            if (intent == ExitIntent.Reset)
            {
                message = SessionStatusText.ResetDone;
            }
        }
    }

    private void RequestClose() => RunExitStep(State.RequestClose, () =>
    {
        if (State.Exit is not null)
        {
            message = "Resolve the open session before it is closed.";
        }
    }, ExitIntent.Close);

    private void RequestReset() => RunExitStep(State.RequestReset, () =>
    {
        if (State.Exit is not null)
        {
            message = "Resolve the open session before it is reset.";
        }
    }, ExitIntent.Reset);

    private void RequestDiscard() => RunExitStep(State.RequestDiscard, () =>
    {
        if (State.Exit is not null)
        {
            message = "Confirm the discard, or cancel to keep this save.";
        }
    }, ExitIntent.Discard);

    private void ApplyDraftForExit() => RunExitStep(State.ApplyDraftForExit, () => message = "Draft applied in memory.");

    private void DiscardDraftForExit() => RunExitStep(State.DiscardDraftForExit, () => message = "Draft discarded.");

    private void ContinueExit() => RunExitStep(State.ConfirmExportChecked);

    private void DiscardSessionForExit() => RunExitStep(State.DiscardSessionForExit);

    /// <summary>
    /// Runs one step of leaving the session and reports it. A refused step (a refused apply or reset, or a step that no longer matches the exit's
    /// stage) changes nothing and is reported like any other refusal, rather than faulting the workspace.
    /// </summary>
    /// <param name="step">The step.</param>
    /// <param name="report">Sets the message for a step that succeeded, before the outcome of a completed exit is reported.</param>
    /// <param name="starts">The exit a request starts; otherwise the step belongs to the exit in progress.</param>
    private void RunExitStep(Action step, Action? report = null, ExitIntent? starts = null)
    {
        var before = Session;
        var intent = starts ?? State.Exit?.Intent;
        try
        {
            step();
        }
        catch (Exception ex)
        {
            ShowError(DiagnosticOperation.Exit, ex);
            return;
        }
        report?.Invoke();
        AfterExitStep(before, intent);
    }

    /// <summary>Acknowledges (or withdraws) the draft's Invalid or Unavailable result, from the editor or the exit panel.</summary>
    private void AcknowledgeLegality(bool acknowledge) => RunAcknowledgement(() => State.AcknowledgeLegality(acknowledge));

    /// <summary>Acknowledges (or withdraws) the flagged changes for this download, from the Download section or the exit panel.</summary>
    private void AcknowledgeExport(bool acknowledge) => RunAcknowledgement(() => State.AcknowledgeExport(acknowledge));

    /// <summary>
    /// Runs an acknowledgement. One made against a result that has just changed (an analysis completed between render and click) is refused by
    /// the state; the page then shows the current result to acknowledge instead of faulting.
    /// </summary>
    private void RunAcknowledgement(Action acknowledge)
    {
        try
        {
            acknowledge();
        }
        catch (InvalidOperationException ex)
        {
            Diagnostics.Record(DiagnosticOperation.Acknowledge, ex);
        }
    }

    private void CancelExit()
    {
        State.CancelExit();
        message = "Current session retained.";
    }

    /// <summary>Opens the activated slot through <see cref="WorkspaceState.OpenSlot"/> and reports what happened.</summary>
    private void OpenSlot(SlotSummary slot)
    {
        if (busy)
        {
            message = UserMessages.For(DropRejection.Busy);
            return;
        }
        var position = SlotText.Position(slot.Ref);
        try
        {
            var outcome = State.OpenSlot(slot.Ref);
            if (outcome is SlotOpening.Opened or SlotOpening.Empty or SlotOpening.Unreadable)
            {
                ResetDraftView();
            }
            if (outcome is SlotOpening.Opened or SlotOpening.AlreadyOpen)
            {
                pendingFocus = PaneFocus.Editor;
            }
            message = outcome switch
            {
                SlotOpening.Opened => $"Opened {SlotText.Label(slot)}. " + OpenedNote(Draft!),
                SlotOpening.AlreadyOpen => $"{position} is already open in the editor.",
                SlotOpening.DraftPending => "Apply or cancel the draft before opening another slot.",
                SlotOpening.Unreadable => $"{position}: {UserMessages.For(SessionError.EntityInvalid)}",
                _ => $"{position} is empty.",
            };
        }
        catch (Exception ex)
        {
            ShowError(DiagnosticOperation.Slot, ex);
        }
    }

    /// <summary>What can be done with a Pokémon that has just been opened.</summary>
    private static string OpenedNote(EditorDraft draft)
    {
        if (!draft.CanApply)
        {
            return UserMessages.For(SessionError.PartyApplyNotAvailable);
        }
        if (draft.IsEgg)
        {
            return UserMessages.For(SessionError.EggNotEditable);
        }
        var fields = EditorText.EditableSummary(draft.Editable);
        return draft.Slot.IsParty ? $"{fields} {PartyText.KeptOnEdit}" : fields;
    }

    /// <summary>Rebuilds the inspector for the current draft, or clears it when there is none. The editor reloads its fields itself.</summary>
    private void ResetDraftView() => inspection = Draft?.Inspect();

    /// <summary>
    /// Runs one edit from the editor on the draft. <see cref="WorkspaceState.SetDraftValid"/> makes the legality result stale and
    /// reschedules it; a refused edit leaves the draft unchanged and marks it invalid until an edit is accepted.
    /// </summary>
    private void Edit(Action<EditorDraft> edit)
    {
        try
        {
            edit(Draft!);
            inspection = Draft!.Inspect();
            State.SetDraftValid(true);
            // The editor now shows the draft as it is, so an earlier edit's refusal no longer describes it.
            if (message == refusal)
            {
                message = "";
            }
        }
        catch (Exception ex)
        {
            State.SetDraftValid(false);
            ShowError(DiagnosticOperation.Edit, ex);
            refusal = message;
        }
    }

    /// <summary>Analyze now: analyses the draft at once instead of waiting for the idle delay.</summary>
    private Task Analyze()
    {
        if (!State.DraftValid)
        {
            message = "Correct or cancel the invalid draft first.";
            return Task.CompletedTask;
        }
        return State.Legality.RunNowAsync();
    }

    /// <summary>Moves focus to the inspector section a legality finding is about.</summary>
    private async Task ShowSection(string id)
    {
        try
        {
            await Page.FocusAsync(id);
        }
        catch (JSException ex)
        {
            Diagnostics.Record(DiagnosticOperation.Focus, ex);
        }
    }

    /// <summary>Waits for the browser to paint the pending state before Core's synchronous analysis starts.</summary>
    private Task WaitForPaintAsync() => Page.NextPaintAsync();

    private void LegalityChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// The cause of an unavailable analysis is recorded, redacted, for the diagnostic report and the browser console; the page says only that
    /// it could not complete.
    /// </summary>
    private void AnalysisFailed(Exception ex) => Diagnostics.Record(DiagnosticOperation.Analyze, ex);

    public void Dispose()
    {
        State.Legality.Changed -= LegalityChanged;
        State.Legality.AnalysisFailed -= AnalysisFailed;
    }

    private void Apply()
    {
        if (Previewing)
        {
            message = EditorText.SpeciesFormPending;
            return;
        }
        try
        {
            State.ApplyDraft();
            ResetDraftView();
            message = "Changes applied in memory; download to retain changes.";
        }
        catch (Exception ex)
        {
            ShowError(DiagnosticOperation.Apply, ex);
        }
    }

    private void CancelDraft()
    {
        State.SetDraft(Session!.Select(Draft!.Slot));
        ResetDraftView();
        message = "Draft canceled.";
    }

    /// <summary>
    /// Downloads the current revision, from the Download button or the exit panel. Only a download handed to the browser is recorded,
    /// so a failed export leaves the session and any exit exactly where they were.
    /// </summary>
    private async Task ExportAsync()
    {
        if (Previewing)
        {
            message = EditorText.SpeciesFormPending;
            return;
        }
        busy = true;
        try
        {
            // The session can be replaced while the download is awaited, so mark the one that was exported.
            var exported = Session!;
            var revision = exported.Revision;
            var name = ExportNaming.NameFor(exported, NameChoice, LocalNow);
            var data = SaveExporter.Export(exported, Draft);
            await Files.DownloadAsync(data, name);
            exported.MarkExported(revision);
            State.NotifyChanged();
            message = SessionStatusText.DownloadStarted;
        }
        catch (Exception ex)
        {
            ShowError(DiagnosticOperation.Export, ex);
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>
    /// Reports a refused or failed operation. A failure (anything but a refusal of the user's input) is recorded, redacted, for the diagnostic
    /// report and the browser console; the page never shows exception details.
    /// </summary>
    private void ShowError(DiagnosticOperation operation, Exception ex)
    {
        Diagnostics.RecordIfFailure(operation, ex);
        message = ex is SessionException refused ? UserMessages.For(refused.Error) : UserMessages.OperationFailed;
    }
}
