@inject BrowserFileService Files
@inject WorkspaceState State

@* The open/edit/download journey. Session state lives in WorkspaceState, so recovering from a fault here keeps the open save. *@
@if (Session is null)
{
    <StartScreen />
}
@* One picker in a fixed place for opening and replacing, so it keeps its drop-zone registration when a save is opened. *@
<h2 id="open-title">@(Session is null ? "Open a save file" : "Open another save file")</h2>
<SaveFilePicker Disabled="busy" OnReadStarted="() => busy = true" OnRead="OpenFile" OnDropRejected="DropRejected" />
<p id="message" role="status">@message</p>
@if (State.Pending is not null)
{
    <section aria-label="Replace session">
        <p>The current session contains changes. Download them first, or explicitly discard this session.</p>
        <button id="replace-confirm" @onclick="ConfirmReplace" disabled="@busy">Discard current session and open</button>
        <button id="replace-cancel" @onclick="CancelReplace" disabled="@busy">Keep current session</button>
    </section>
}
@if (Session is not null)
{
    <section aria-label="Save overview">
        <h2>Loaded save</h2>
        <p>Family: <strong id="family">@Session.Family</strong>. Integrity: <strong id="integrity">Valid</strong>.</p>
        <p id="session-state">@(Session.HasChangesSinceOpen ? "Edited in memory" : "Unmodified session")</p>
        <p id="session-note">This save is processed only on this device. Changes are temporary until you download them; reloading or closing the tab discards this session.</p>
        <label for="slot">Occupied box slot</label>
        <select id="slot" value="@(Draft?.SlotIndex ?? -1)" @onchange="SelectSlot" disabled="@(State.DraftDirty || busy || !State.DraftValid)">
            <option value="-1">Choose a slot</option>
            @foreach (var index in Session.OccupiedSlots)
            {
                <option value="@index">@Session.SlotLabel(index)</option>
            }
        </select>
        @if (Session.OccupiedSlots.Count == 0)
        {
            <p>No occupied box slots were found. A no-op round trip is still available.</p>
        }
    </section>
    @if (Draft is not null)
    {
        <section aria-label="Nickname editor">
            <h2>Nickname draft</h2>
            <label for="nickname">Nickname</label>
            <input id="nickname" value="@nickname" @oninput="NicknameChanged" maxlength="@Draft.MaxNicknameLength" />
            <label><input id="nicknamed" type="checkbox" checked="@nicknamed" @onchange="NicknameFlagChanged" /> Is nicknamed</label>
            <p id="draft-state">@(State.DraftDirty ? "Unapplied draft" : "No draft changes")</p>
            <button id="analyze" @onclick="Analyze">Analyze legality</button>
            <button id="apply" @onclick="Apply" disabled="@(!State.DraftDirty || !State.DraftValid)">Apply nickname</button>
            <button id="cancel-draft" @onclick="CancelDraft">Cancel draft</button>
            <p>Legality is diagnostic. Applying does not legalize or change ownership, dex entries, or trainer records.</p>
            <p id="legality-status" role="status">@verdict</p>
            <pre id="legality-report">@report</pre>
        </section>
    }
    <button id="download" @onclick="Download" disabled="@(State.DraftDirty || busy || !State.DraftValid)">Download validated save</button>
    <p>Suggested name: <code>@Session.FileName</code> (your browser may adjust it). Download initiation does not confirm it was saved to disk. Verify your file before closing.</p>
}

@code {
    private string message = "", nickname = "", verdict = "Not analyzed", report = "";
    private bool nicknamed, busy;

    private SaveSession? Session => State.Session;
    private EditorDraft? Draft => State.Draft;

    protected override void OnInitialized()
    {
        // A new instance with a session already open means the workspace was recovered after a fault.
        message = Session is null ? "Choose a save to begin." : "The open save was kept. Any unapplied draft was discarded.";
    }

    private void OpenFile(FileReadResult file)
    {
        busy = false;
        State.CancelReplace();
        if (file.Status != FileReadStatus.Ok)
        {
            message = file.Status switch
            {
                FileReadStatus.Empty => "The file is empty.",
                FileReadStatus.TooLarge => "The file exceeds the 16 MiB limit.",
                _ => "The file could not be read. Choose it again.",
            } + Retained;
            return;
        }

        try
        {
            var candidate = SaveLoader.Load(file.Bytes, file.FileName);
            if (State.HasUnsavedWork)
            {
                State.OfferReplacement(candidate);
                message = "Resolve the existing session before replacement.";
            }
            else
            {
                SetSession(candidate);
            }
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
    }

    private void DropRejected(DropRejection rejection) => message = rejection switch
    {
        DropRejection.MultipleFiles => "Drop a single save file." + Retained,
        DropRejection.Directory => "Drop a save file, not a folder." + Retained,
        DropRejection.Busy => "Wait for the current operation to finish, then try again.",
        _ => "Only files can be dropped here, not text or links." + Retained,
    };

    /// <summary>Appended to refusals, but only when there is a session that the refusal left untouched.</summary>
    private string Retained => Session is null ? "" : " The previous session was retained.";

    private void SetSession(SaveSession candidate)
    {
        State.Open(candidate);
        ResetDraftView();
        message = "Save loaded locally; checksums valid.";
    }

    private void ConfirmReplace()
    {
        if (State.Pending is { } pending)
        {
            SetSession(pending);
        }
    }

    private void CancelReplace()
    {
        State.CancelReplace();
        message = "Current session retained.";
    }

    private void SelectSlot(ChangeEventArgs e)
    {
        try
        {
            var index = int.Parse(e.Value!.ToString()!);
            if (index < 0)
            {
                State.SetDraft(null);
                message = "Choose a slot to edit.";
                return;
            }
            State.SetDraft(Session!.Select(index));
            ResetDraftView();
            message = "Slot selected. Only nickname fields can be changed.";
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
    }

    /// <summary>Shows the current draft's values, or clears the editor when there is none.</summary>
    private void ResetDraftView()
    {
        nickname = Draft?.Nickname ?? "";
        nicknamed = Draft?.IsNicknamed ?? false;
        verdict = "Not analyzed";
        report = "";
    }

    private void NicknameChanged(ChangeEventArgs e)
    {
        nickname = e.Value?.ToString() ?? "";
        UpdateDraft();
    }

    private void NicknameFlagChanged(ChangeEventArgs e)
    {
        nicknamed = e.Value is true;
        UpdateDraft();
    }

    private void UpdateDraft()
    {
        verdict = "Stale — analyze the current draft";
        report = "";
        try
        {
            Draft!.EditNickname(nickname, nicknamed);
            State.SetDraftValid(true);
        }
        catch (Exception ex)
        {
            State.SetDraftValid(false);
            ShowError(ex);
        }
    }

    private void Analyze()
    {
        if (!State.DraftValid)
        {
            message = "Correct or cancel the invalid draft first.";
            return;
        }
        try
        {
            var result = Draft!.Analyze(Session!);
            verdict = result.Verdict;
            report = result.Report;
        }
        catch
        {
            verdict = "Unavailable";
            report = "Analysis could not complete. No changes were made.";
        }
    }

    private void Apply()
    {
        try
        {
            Session!.Apply(Draft!);
            // The session changed; report it now, so the leave warning is armed even if reselecting the slot fails.
            State.NotifyChanged();
            State.SetDraft(Session.Select(Draft!.SlotIndex));
            ResetDraftView();
            message = "Nickname applied in memory; download to retain changes.";
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
    }

    private void CancelDraft()
    {
        State.SetDraft(Session!.Select(Draft!.SlotIndex));
        ResetDraftView();
        message = "Draft canceled.";
    }

    private async Task Download()
    {
        busy = true;
        try
        {
            // The session can be replaced while the download is awaited, so mark the one that was exported.
            var exported = Session!;
            var revision = exported.Revision;
            var data = SaveExporter.Export(exported, Draft);
            await Files.DownloadAsync(data, exported.FileName);
            exported.MarkExported(revision);
            State.NotifyChanged();
            message = "Download started — verify your file. The session remains temporary.";
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private void ShowError(Exception ex) => message = ex is InvalidDataException ? ex.Message : "Operation failed. The previous session was retained; no file was overwritten.";
}
