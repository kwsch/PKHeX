<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time generator for PKHeX.Web's sprite atlas. It reads PKHeX.Drawing.PokeSprite's own images through that project's
    Resources.resx and packs the ones X/Y and Omega Ruby/Alpha Sapphire can show into one PNG, a stylesheet and a manifest.
    PKHeX.Web runs it only when published with -p:PKHeXWebSprites=true; it is never part of the published app.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PKHeX.Core\PKHeX.Core.csproj" />
  </ItemGroup>

  <!-- One source of truth for sprite selection: the desktop's resource naming, and the Web's key resolution built on it. -->
  <ItemGroup>
    <Compile Include="..\PKHeX.Drawing.PokeSprite\Util\SpriteName.cs" Link="Shared\SpriteName.cs" />
    <Compile Include="..\PKHeX.Web\Services\Sprites\SpriteKeys.cs" Link="Shared\SpriteKeys.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PKHeX.Web.Tests" />
  </ItemGroup>

</Project>
